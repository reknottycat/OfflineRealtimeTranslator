<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_arrow_back"
            app:tint="#FFF0F0F0" android:contentDescription="@string/back"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:text="@string/ui_settings_heading" android:textSize="18sp"
            android:textColor="#FFF7F7F7" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/ui_local_first" android:textSize="11sp" android:textColor="#FF9BA79F"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingTop="12dp"
            android:paddingBottom="28dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/ui_models_heading" android:textSize="25sp" android:textStyle="bold"
                android:textColor="#FFF6F6F6"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:layout_marginBottom="20dp"
                android:text="@string/ui_models_intro"
                android:textSize="12sp" android:lineSpacingExtra="2dp" android:textColor="#FFA5A7A6"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/bg_settings_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_asr_section" android:textColor="#FFF5F5F5" android:textStyle="bold" android:textSize="18sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="15dp" android:text="@string/ui_asr_intro" android:textColor="#FFAAAAAA" android:textSize="12sp"/>
<RadioGroup android:id="@+id/radio_asr_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<RadioButton android:id="@+id/rb_asr_small" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_vosk_small_option" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
<RadioButton android:id="@+id/rb_asr_large" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_vosk_large_option" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
<RadioButton android:id="@+id/rb_asr_gigaam" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_gigaam_option" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
<RadioButton android:id="@+id/rb_asr_nemotron" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_nemotron_option" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
<RadioButton android:id="@+id/rb_asr_qwen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_qwen_asr_option" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
</RadioGroup>
<TextView android:id="@+id/tv_asr_language_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_input_language" android:textColor="#FFE2E2E2" android:textSize="13sp" android:visibility="gone"/>
<Spinner android:id="@+id/spinner_asr_language" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="40dp" android:background="@drawable/ui_spinner_field" android:spinnerMode="dropdown" android:visibility="gone"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:layout_marginBottom="7dp" android:text="@string/ui_download_source" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFC7C9C8"/>
<Spinner android:id="@+id/spinner_asr_source" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="40dp" android:background="@drawable/ui_spinner_field" android:spinnerMode="dropdown"/>
<TextView android:id="@+id/tv_asr_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="#FFA8AAA9"/>
<EditText android:id="@+id/et_asr_url" android:importantForAutofill="no" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:paddingHorizontal="12dp" android:singleLine="true" android:inputType="textUri" android:hint="@string/ui_asr_url_hint" android:textSize="13sp" android:textColor="#FFF1F1F1" android:textColorHint="#FF999999" android:background="@drawable/ui_input_field" android:visibility="gone"/>
<TextView android:id="@+id/tv_asr_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="#FFA8AAA9"/>
<ProgressBar android:id="@+id/progress_asr" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="9dp" android:max="100" android:progressTint="#FF19C59A" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_download_asr" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="@string/ui_asr_download" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:textColor="#FF09281F" app:cornerRadius="13dp" app:backgroundTint="#FF19C59A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_download_asr_cpu" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="@string/ui_cpu_fallback_download" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFF1F1F1" android:visibility="gone" app:cornerRadius="13dp" app:backgroundTint="#FF363738"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_pause_asr" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="@string/ui_asr_pause" android:textAllCaps="false" android:textSize="14sp" android:textStyle="normal" android:textColor="#FFF1F1F1" app:cornerRadius="13dp" app:backgroundTint="#FF363738"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/btn_import_asr" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:text="@string/ui_model_import" android:textSize="13sp" android:textAllCaps="false" android:textColor="#FFF0F0F0" app:cornerRadius="13dp" app:backgroundTint="#FF333435"/><com.google.android.material.button.MaterialButton android:id="@+id/btn_remove_asr" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:text="@string/ui_model_delete" android:textSize="13sp" android:textAllCaps="false" android:textColor="#FFF0F0F0" app:cornerRadius="13dp" app:backgroundTint="#FF333435"/></LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_import_asr_folder" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="@string/ui_vosk_import_folder" android:textAllCaps="false" android:textSize="14sp" android:textStyle="normal" android:textColor="#FFF1F1F1" app:cornerRadius="13dp" app:backgroundTint="#FF363738"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11sp" android:textColor="#FF8E9290" android:text="@string/ui_vosk_large_note"></TextView>
</LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/bg_settings_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_translation_section" android:textColor="#FFF5F5F5" android:textStyle="bold" android:textSize="18sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="15dp" android:text="@string/ui_translation_intro" android:textColor="#FFAAAAAA" android:textSize="12sp"/>
<RadioGroup android:id="@+id/radio_translation_engine" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<RadioButton android:id="@+id/rb_gemma4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_gemma_option" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
<RadioButton android:id="@+id/rb_lmt" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_lmt_option" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
</RadioGroup>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:layout_marginBottom="7dp" android:text="@string/ui_backend_label" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFC7C9C8"/>
<RadioGroup android:id="@+id/radio_inference_backend" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<RadioButton android:id="@+id/rb_backend_auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_backend_auto" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
<RadioButton android:id="@+id/rb_backend_gpu" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_backend_gpu" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
<RadioButton android:id="@+id/rb_backend_cpu" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginBottom="7dp" android:paddingHorizontal="12dp" android:text="@string/ui_backend_cpu" android:textColor="#FFF0F0F0" android:textSize="14sp" android:buttonTint="#FF19C59A" android:background="@drawable/ui_option_row"/>
</RadioGroup>
<TextView android:id="@+id/tv_backend_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="#FFA8AAA9"/>
</LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/bg_settings_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_download_section" android:textColor="#FFF5F5F5" android:textStyle="bold" android:textSize="18sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="15dp" android:text="@string/ui_download_intro" android:textColor="#FFAAAAAA" android:textSize="12sp"/>
<TextView android:id="@+id/tv_model_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="#FFA8AAA9"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:layout_marginBottom="7dp" android:text="@string/ui_download_source" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFC7C9C8"/>
<Spinner android:id="@+id/spinner_model_source" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="40dp" android:background="@drawable/ui_spinner_field" android:spinnerMode="dropdown"/>
<TextView android:id="@+id/tv_source_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="#FFA8AAA9"/>
<EditText android:id="@+id/et_model_url" android:importantForAutofill="no" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:paddingHorizontal="12dp" android:singleLine="true" android:inputType="textUri" android:hint="@string/ui_translation_url_hint" android:textSize="13sp" android:textColor="#FFF1F1F1" android:textColorHint="#FF999999" android:background="@drawable/ui_input_field" android:visibility="gone"/>
<TextView android:id="@+id/tv_model_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="#FFA8AAA9"/>
<ProgressBar android:id="@+id/progress_model" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="9dp" android:max="100" android:progressTint="#FF19C59A" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_download_model" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="@string/ui_translation_download" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:textColor="#FF09281F" app:cornerRadius="13dp" app:backgroundTint="#FF19C59A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_pause_model" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="@string/ui_translation_pause" android:textAllCaps="false" android:textSize="14sp" android:textStyle="normal" android:textColor="#FFF1F1F1" app:cornerRadius="13dp" app:backgroundTint="#FF363738"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/btn_import_model" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:text="@string/ui_translation_import" android:textSize="13sp" android:textAllCaps="false" android:textColor="#FFF0F0F0" app:cornerRadius="13dp" app:backgroundTint="#FF333435"/><com.google.android.material.button.MaterialButton android:id="@+id/btn_remove_model" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:text="@string/ui_model_delete" android:textSize="13sp" android:textAllCaps="false" android:textColor="#FFF0F0F0" app:cornerRadius="13dp" app:backgroundTint="#FF333435"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="11sp" android:lineSpacingExtra="2dp" android:textColor="#FF909392" android:text="@string/ui_download_note"></TextView>
</LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/bg_settings_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_preferences_section" android:textColor="#FFF5F5F5" android:textStyle="bold" android:textSize="18sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="15dp" android:text="@string/ui_preferences_intro" android:textColor="#FFAAAAAA" android:textSize="12sp"/>
<androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_drift_retry" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/drift_retry_title" android:textColor="#FFF1F1F1" android:textSize="14sp" android:thumbTint="#FF19C59A"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/drift_retry_desc" android:textSize="12sp" android:textColor="#FFA5A7A6"></TextView>
