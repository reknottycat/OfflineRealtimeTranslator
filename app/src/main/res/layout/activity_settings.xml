<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FF121212">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#FF1E1E1E" android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside" android:contentDescription="@string/back" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_title" android:textSize="16sp" android:textColor="#FFFFFFFF" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingHorizontal="20dp" android:paddingBottom="12dp" android:text="离线翻译"
                android:textSize="24sp" android:textStyle="bold" android:textColor="#FFF5F6F6" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp" android:layout_marginBottom="12dp"
                android:padding="16dp" android:orientation="vertical" android:background="@drawable/bg_settings_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="翻译引擎" android:textColor="#FFF5F5F5" android:textStyle="bold" android:textSize="16sp" />
                <RadioGroup android:id="@+id/radio_translation_engine" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/rb_gemma4" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:buttonTint="#FF10A37F" android:textColor="#FFECECEC" android:text="Gemma 4 E2B · LiteRT-LM" />
                    <RadioButton android:id="@+id/rb_lmt" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:buttonTint="#FF10A37F" android:textColor="#FFECECEC" android:text="NiuTrans LMT-60-1.7B · llama.cpp" />
                </RadioGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="计算设备" android:textStyle="bold" android:textColor="#FFF5F5F5" android:textSize="15sp" />
                <RadioGroup android:id="@+id/radio_inference_backend" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/rb_backend_auto" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="自动 · 优先 GPU，失败回退 CPU" android:buttonTint="#FF10A37F" android:textColor="#FFECECEC" />
                    <RadioButton android:id="@+id/rb_backend_gpu" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="优先 GPU" android:buttonTint="#FF10A37F" android:textColor="#FFECECEC" />
                    <RadioButton android:id="@+id/rb_backend_cpu" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="仅 CPU" android:buttonTint="#FF10A37F" android:textColor="#FFECECEC" />
                </RadioGroup>
                <TextView android:id="@+id/tv_backend_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="切换后返回主页面重新加载；不会同时加载两个翻译模型" android:textColor="#FF979AA3" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp" android:layout_marginBottom="12dp" android:padding="16dp"
                android:orientation="vertical" android:background="@drawable/bg_settings_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="模型管理 · 跟随所选引擎" android:textColor="#FFF5F5F5" android:textStyle="bold" android:textSize="16sp" />
                <TextView android:id="@+id/tv_model_description" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textColor="#FFA7ABB4" android:textSize="13sp" />
                <Spinner android:id="@+id/spinner_model_source" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/tv_source_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FF9297A0" android:textSize="12sp" />
                <EditText android:id="@+id/et_model_url" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textUri" android:singleLine="true" android:hint="所选模型的 HTTPS 文件直链（可选镜像）"
                    android:textColor="#FFECECEC" android:textColorHint="#FF9297A0" android:visibility="gone" />
                <TextView android:id="@+id/tv_model_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#FFA7ABB4" android:textSize="13sp" />
                <ProgressBar android:id="@+id/progress_model" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
                    android:max="100" android:progressTint="#FF10A37F" android:visibility="gone" />
                <Button android:id="@+id/btn_download_model" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="下载 / 继续下载" />
                <Button android:id="@+id/btn_pause_model" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="暂停下载，保留断点" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_import_model" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="从文件导入" />
                    <Button android:id="@+id/btn_remove_model" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="删除所选模型" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="4 MiB 分块，默认 4 路并发；每块失败自动轮换来源，最多尝试 8 次。支持暂停续传，完成后校验整个模型。下载时保持此页面打开；退出或旋转屏幕后，返回并点击继续下载即可恢复。模型文件不包含在 APK 内。"
                    android:textSize="12sp" android:textColor="#FF9297A0" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/asr_model_title" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/asr_model_desc" android:textSize="13sp" android:textColor="#FF888888" />
                <RadioGroup android:id="@+id/radio_asr_model" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/rb_asr_small" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/asr_model_small" android:textColor="#FFFFFFFF" android:buttonTint="#FF10A37F" />
                    <RadioButton android:id="@+id/rb_asr_large" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/asr_model_large" android:textColor="#FFFFFFFF" android:buttonTint="#FF10A37F" />
                </RadioGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="下载来源" android:textColor="#FFF5F5F5"
                    android:textStyle="bold" android:textSize="14sp" />
                <Spinner android:id="@+id/spinner_asr_source" android:layout_width="match_parent"
                    android:layout_height="48dp" />
                <TextView android:id="@+id/tv_asr_hint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#FF9297A0" android:textSize="12sp" />
                <EditText android:id="@+id/et_asr_url" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textUri"
                    android:singleLine="true" android:hint="Vosk ZIP 的自定义 HTTPS 下载直链"
                    android:textColor="#FFECECEC" android:textColorHint="#FF9297A0"
                    android:visibility="gone" />
                <TextView android:id="@+id/tv_asr_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textColor="#FFA7ABB4" android:textSize="13sp" />
                <ProgressBar android:id="@+id/progress_asr" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="6dp"
                    android:layout_marginTop="8dp" android:max="100"
                    android:progressTint="#FF10A37F" android:visibility="gone" />
                <Button android:id="@+id/btn_download_asr" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="下载 / 继续下载所选 Vosk 模型" />
                <Button android:id="@+id/btn_pause_asr" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="暂停 Vosk 下载，保留断点"
                    android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_import_asr" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="导入 Vosk ZIP" />
                    <Button android:id="@+id/btn_remove_asr" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="删除所选 Vosk" />
                </LinearLayout>
                <Button android:id="@+id/btn_import_asr_folder"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="导入已解压 Vosk 文件夹（约 3.5 GB）" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:layout_marginBottom="10dp"
                    android:text="Large 官网 ZIP 下载约 1.84 GB；原仓库的 3.5 GB 是解压后文件夹大小。已解压的文件夹请用上方导入，不能当作 ZIP 文件导入。"
                    android:textSize="12sp" android:textColor="#FF9297A0" />

                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_drift_retry"
                    android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp"
                    android:text="@string/drift_retry_title" android:textColor="#FFFFFFFF" android:thumbTint="#FF10A37F" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/drift_retry_desc" android:textColor="#FF888888" android:textSize="13sp" />
                <TextView android:id="@+id/tv_version" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:textColor="#FF888888" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
